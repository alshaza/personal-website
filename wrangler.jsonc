{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  // The @astrojs/cloudflare adapter wires the worker entry + static assets at build time.
  // Run `wrangler d1 create alshaza` and paste the returned database_id below, then
  // `wrangler d1 migrations apply alshaza --local` (dev) / `--remote` (production).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alshaza",
      "database_id": "791238c4-02f6-480c-931b-60c25643995f",
      "migrations_dir": "migrations"
    }
  ]
}