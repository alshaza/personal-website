---
export const prerender = false

import { getPublishedPostBySlug } from '../../lib/db'

const { slug } = Astro.params
const { DB } = Astro.locals.runtime.env

let post = null
try {
  post = slug ? await getPublishedPostBySlug(DB, slug) : null
} catch (err) {
  console.error('getPublishedPostBySlug failed:', err)
}

if (!post) {
  return Astro.redirect('/blog', 302)
}

// Legacy flat post URL (pre-categories). Redirect permanently to the
// category-scoped URL so previously indexed/shared links keep working.
return Astro.redirect(`/blog/${post.category_slug}/${post.slug}`, 301)
---
