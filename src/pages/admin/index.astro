---
export const prerender = false

import AdminLayout from '../../layouts/AdminLayout.astro'
import { deletePost, listAllPosts, updatePost, getPostById } from '../../lib/db'

const { DB } = Astro.locals.runtime.env

let pageError: string | null = null
let posts: Awaited<ReturnType<typeof listAllPosts>> = []

try {
  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const intent = String(form.get('intent') ?? '')
    const id = Number(form.get('id'))

    if (intent === 'delete' && id) {
      await deletePost(DB, id)
    } else if (intent === 'toggle-status' && id) {
      const post = await getPostById(DB, id)
      if (post) {
        await updatePost(DB, id, {
          slug: post.slug,
          title: post.title,
          subtitle: post.subtitle,
          description: post.description,
          body_md: post.body_md,
          body_html: post.body_html,
          status: post.status === 'published' ? 'draft' : 'published',
          category_id: post.category_id,
        })
      }
    }

    return Astro.redirect('/admin')
  }

  posts = await listAllPosts(DB)
} catch (err) {
  pageError = err instanceof Error ? (err.stack ?? err.message) : String(err)
}
---

<AdminLayout title="Posts">
  <h1>Posts</h1>
  {pageError ? (
    <div class="card error">
      <strong>Something went wrong:</strong>
      <pre>{pageError}</pre>
    </div>
  ) : posts.length === 0 ? (
    <div class="card empty-state">
      No posts yet. <a href="/admin/new">Create the first one</a>.
    </div>
  ) : (
    <div class="card" style="padding:0; overflow:hidden;">
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Status</th>
            <th>Views</th>
            <th>Reactions</th>
            <th>Updated</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {posts.map((post) => (
            <tr>
              <td>
                <a href={`/admin/${post.id}/edit`}>{post.title}</a>
              </td>
              <td>{post.category_name ?? '—'}</td>
              <td>
                <span class={`badge ${post.status}`}>{post.status}</span>
              </td>
              <td class="numeric">{post.views}</td>
              <td class="numeric">🔥 {post.fire_count}</td>
              <td>{new Date(post.updated_at).toLocaleDateString()}</td>
              <td class="actions">
                <a class="button secondary" href={`/blog/${post.category_slug}/${post.slug}`} target="_blank" rel="noopener">
                  View
                </a>
                <form method="POST">
                  <input type="hidden" name="id" value={post.id} />
                  <input type="hidden" name="intent" value="toggle-status" />
                  <button type="submit" class={post.status === 'published' ? 'secondary' : 'success'}>
                    {post.status === 'published' ? 'Unpublish' : 'Publish'}
                  </button>
                </form>
                <form method="POST" onsubmit="return confirm('Delete this post permanently?')">
                  <input type="hidden" name="id" value={post.id} />
                  <input type="hidden" name="intent" value="delete" />
                  <button type="submit" class="danger">
                    Delete
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>
