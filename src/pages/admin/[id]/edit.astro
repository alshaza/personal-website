---
export const prerender = false

import AdminLayout from '../../../layouts/AdminLayout.astro'
import MarkdownEditorField from '../../../components/admin/MarkdownEditorField.astro'
import { findOrCreateCategory, getPostById, listCategories, updatePost } from '../../../lib/db'
import { renderMarkdown, excerptFromMarkdown } from '../../../lib/markdown'

const { DB } = Astro.locals.runtime.env
const id = Number(Astro.params.id)

let pageError: string | null = null
let error: string | null = null
let existing: Awaited<ReturnType<typeof getPostById>> = null
let values = { title: '', body_md: '', status: 'draft' as 'draft' | 'published', category: '' }
let categories: Awaited<ReturnType<typeof listCategories>> = []

try {
  existing = await getPostById(DB, id)

  if (!existing) {
    return Astro.redirect('/admin')
  }

  values = {
    title: existing.title,
    body_md: existing.body_md,
    status: existing.status,
    category: existing.category_name ?? '',
  }

  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData()
    const title = String(form.get('title') ?? '').trim()
    const body_md = String(form.get('body_md') ?? '')
    const status = form.get('status') === 'published' ? 'published' : 'draft'
    const category = String(form.get('category') ?? '').trim()

    values = { title, body_md, status, category }

    if (!title || !body_md || !category) {
      error = 'Title, body, and category are required.'
    } else {
      const description = excerptFromMarkdown(body_md)
      const body_html = renderMarkdown(body_md)
      const category_id = (await findOrCreateCategory(DB, category)) as number
      await updatePost(DB, id, {
        slug: existing.slug,
        title,
        subtitle: existing.subtitle,
        description,
        body_md,
        body_html,
        status,
        category_id,
      })
      return Astro.redirect('/admin')
    }
  }

  categories = await listCategories(DB)
} catch (err) {
  pageError = err instanceof Error ? (err.stack ?? err.message) : String(err)
}
---

<AdminLayout title={pageError ? 'Error' : `Edit: ${existing?.title ?? ''}`}>
  <h1>Edit post</h1>
  {pageError ? (
    <div class="card error">
      <strong>Something went wrong:</strong>
      <pre>{pageError}</pre>
    </div>
  ) : existing ? (
  <>
  {error && <p class="error">{error}</p>}
  <div class="card">
    <form method="POST" class="stacked-form">
      <div class="field">
        <label>URL</label>
        <div class="readonly-value">
          <span>/blog/{existing.category_slug}/{existing.slug}</span>
          <a href={`/blog/${existing.category_slug}/${existing.slug}`} target="_blank" rel="noopener">↗</a>
        </div>
        <span class="hint">
          The slug is set once from the title and doesn't change on edit; the category segment updates automatically
          if you change the category below.
        </span>
      </div>

      <div class="field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value={values.title} required />
      </div>

      <div class="field">
        <label for="body_md">Body</label>
        <span class="hint">The SEO description is regenerated automatically from the body on save.</span>
        <MarkdownEditorField name="body_md" initialValue={values.body_md} />
      </div>

      <div class="field">
        <label for="category">Category</label>
        <span class="hint">Pick an existing category or type a new one to create it.</span>
        <input type="text" id="category" name="category" value={values.category} list="category-list" required />
        <datalist id="category-list">
          {categories.map((c) => <option value={c.name} />)}
        </datalist>
      </div>

      <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="draft" selected={values.status === 'draft'}>Draft</option>
          <option value="published" selected={values.status === 'published'}>Published</option>
        </select>
      </div>

      <button type="submit" class="submit">Save changes</button>
    </form>
  </div>
  </>
  ) : null}
</AdminLayout>
