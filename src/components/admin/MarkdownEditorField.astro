---
interface Props {
  name: string
  initialValue?: string
}

const { name, initialValue = '' } = Astro.props
---

<div class="md-editor-field" data-field-name={name}>
  <textarea name={name} class="md-editor-source" style="display:none">{initialValue}</textarea>
  <div class="md-editor-mount"></div>
</div>

<style>
  .md-editor-mount {
    margin-bottom: 16px;
  }
</style>

<script>
  // @ts-expect-error — @toast-ui/editor's package.json `exports` field doesn't resolve its own types.
  import Editor from '@toast-ui/editor'
  import '@toast-ui/editor/dist/toastui-editor.css'

  document.querySelectorAll<HTMLElement>('.md-editor-field').forEach((field) => {
    const textarea = field.querySelector<HTMLTextAreaElement>('.md-editor-source')
    const mount = field.querySelector<HTMLElement>('.md-editor-mount')
    if (!textarea || !mount) return

    const editor = new Editor({
      el: mount,
      height: '480px',
      initialEditType: 'wysiwyg',
      previewStyle: 'vertical',
      initialValue: textarea.value,
    })

    field.closest('form')?.addEventListener('submit', () => {
      textarea.value = editor.getMarkdown()
    })
  })
</script>
